{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDirs": ["tests/fixtures/maintained-ts-shop/overlay", "tests/fixtures/ts-shop"],
    "paths": {
      "@storage/*": ["./tests/fixtures/ts-shop/packages/core/internal/*.ts"],
      "typescript": ["./node_modules/@typescript/typescript6/lib/typescript.d.ts"]
    }
  },
  "include": ["scripts/**/*.ts", "tests/scripts/**/*.ts", "tests/inputs/**/*.ts", "tests/fixtures/**/*.ts", "tests/eval/container/assertions.ts", "upstream/fetch.ts"],
  "exclude": ["tests/fixtures/**/node_modules"]
}
