{
  "title": "Declared change paths version 1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "writePaths", "contracts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "writePaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "files"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
