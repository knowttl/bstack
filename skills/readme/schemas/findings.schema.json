{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stage",
    "target",
    "nextChange",
    "reviewedScope",
    "sources",
    "findings",
    "selectedFindingIds",
    "requiredOutcomes",
    "execution",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "stage": {
      "enum": [
        "audit",
        "foundation"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "root",
        "revision"
      ],
      "properties": {
        "mode": {
          "enum": [
            "repo",
            "workspace"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "nextChange": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reviewedScope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pointer",
          "intent",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "pointer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "intent": {
            "enum": [
              "documented",
              "observed",
              "inferred"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "problem",
          "files",
          "command",
          "principle",
          "consequence",
          "fix",
          "scope",
          "verification",
          "blocksNextChange",
          "category",
          "status",
          "newPrinciple",
          "resolved",
          "sourceIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[0-9]{3,}$"
          },
          "problem": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "command": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "principle": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "consequence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "fix": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "blocksNextChange": {
            "type": "boolean"
          },
          "category": {
            "enum": [
              "debt",
              "missing-protection",
              "decision"
            ]
          },
          "status": {
            "enum": [
              "proposed",
              "selected",
              "rejected"
            ]
          },
          "newPrinciple": {
            "type": "boolean"
          },
          "resolved": {
            "type": "boolean"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          }
        }
      }
    },
    "selectedFindingIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "requiredOutcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "execution": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "outcome",
          "status",
          "fingerprint",
          "artifact",
          "artifactHash",
          "method"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "outcome": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "skipped"
            ]
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "artifact": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "artifactHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  }
}
