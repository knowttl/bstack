{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "target", "findings", "findingsDigest", "selectedFindingIds", "reviewedScope", "edits", "planDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "root", "revision"],
      "properties": {
        "mode": { "enum": ["repo", "workspace"] },
        "root": { "type": "string", "pattern": "\\S" },
        "revision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "findings": { "type": "string", "pattern": "\\S" },
    "findingsDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "selectedFindingIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^F-[0-9]{3,}$" } },
    "reviewedScope": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "resolvedPath"],
        "properties": {
          "path": { "type": "string", "pattern": "\\S" },
          "resolvedPath": { "type": "string", "pattern": "\\S" }
        }
      }
    },
    "edits": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "findingId", "path", "originalHash", "proposedHash", "operation", "payload", "proposedContent"],
        "properties": {
          "id": { "type": "string", "pattern": "\\S" },
          "findingId": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
          "path": { "type": "string", "pattern": "\\S" },
          "originalHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "proposedHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "operation": { "enum": ["create", "replace", "delete", "set-heading-section", "set-json-key", "append-line-once"] },
          "payload": { "type": "object" },
          "proposedContent": { "type": ["string", "null"] }
        }
      }
    },
    "planDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
