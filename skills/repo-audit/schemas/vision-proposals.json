{
  "title": "VISION board proposals version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "draftRevision", "project", "runNote", "cards"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "draftRevision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "project": { "type": "string", "minLength": 1 },
    "runNote": { "type": "string" },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "body", "tests", "why"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "tests": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
