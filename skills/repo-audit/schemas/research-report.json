{
  "title": "Research report version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "host", "capabilities", "briefs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "enum": ["main-thread", "subagents"] },
    "host": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["subagents", "web"],
      "properties": { "subagents": { "type": "boolean" }, "web": { "type": "boolean" } }
    },
    "briefs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "scope", "findings", "limitations", "files", "web"],
        "properties": {
          "id": { "enum": ["documents", "architecture", "checks", "language", "outside"] },
          "scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "findings": { "type": "string", "minLength": 1 },
          "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "files": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["location", "state"],
              "properties": {
                "location": { "type": "string", "pattern": "^.+:[1-9][0-9]*$" },
                "state": {
                  "type": "object", "additionalProperties": false,
                  "required": ["kind", "value"],
                  "properties": {
                    "kind": { "enum": ["sha256", "revision"] },
                    "value": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" }
                  }
                }
              }
            }
          },
          "web": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["url", "readDate", "verification"],
              "properties": {
                "url": { "type": "string", "minLength": 1 },
                "readDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "verification": { "enum": ["verified", "unverified"] }
              }
            }
          }
        }
      }
    }
  }
}
