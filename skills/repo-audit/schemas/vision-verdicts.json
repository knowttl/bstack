{
  "title": "Complete VISION review round version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "draftRevision", "complete", "verdicts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "draftRevision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "complete": { "const": true },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verdict", "notes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["In vision", "Off mission", "Conditional"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
