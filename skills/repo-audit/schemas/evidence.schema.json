{
  "title": "Change-specific maintenance assessment version 1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "repo", "contract", "base", "head", "changes", "paths", "mappings", "unmappedPaths", "documents", "unmappedAssessments", "decisions", "coverage", "execution", "fingerprint"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repo": { "type": "string", "minLength": 1 },
    "contract": { "type": "string", "minLength": 1 },
    "previousContract": { "type": ["string", "null"], "minLength": 1 },
    "base": {
      "type": "object", "additionalProperties": false, "required": ["ref", "kind", "objectId"],
      "properties": { "ref": { "type": "string" }, "kind": { "enum": ["commit", "empty-tree"] }, "objectId": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
    },
    "head": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "changes": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["source", "status", "path"],
        "properties": { "source": { "enum": ["committed", "staged", "unstaged", "new"] }, "status": { "type": "string" }, "path": { "type": "string" }, "oldPath": { "type": "string" } }
      }
    },
    "paths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "mappings": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "scopeIds", "documentIds", "ruleIds"],
        "properties": {
          "path": { "type": "string" },
          "scopeIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "documentIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "ruleIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "unmappedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "documents": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "path", "assessment"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 },
          "assessment": { "type": ["object", "null"] }
        }
      }
    },
    "unmappedAssessments": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "assessment"],
        "properties": { "path": { "type": "string" }, "assessment": { "type": ["object", "null"] } }
      }
    },
    "decisions": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "status", "source", "oldCase", "newCase", "affectedWork"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "status": { "enum": ["pending", "approved"] },
          "source": { "type": "string", "minLength": 1 }, "oldCase": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "newCase": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "affectedWork": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "\\S" } },
          "approval": { "type": "object" }
        }
      }
    },
    "coverage": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "execution": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["runId", "plan"],
        "properties": { "runId": { "type": "string", "minLength": 1 }, "plan": { "type": "string", "minLength": 1 } }
      }
    },
    "fingerprint": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "foundation": {
      "type": "object", "additionalProperties": false, "required": ["findingId", "record"],
      "properties": { "findingId": { "type": "string", "minLength": 1 }, "record": { "type": "object" } }
    }
  }
}
