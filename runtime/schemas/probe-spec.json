{
  "title": "Live probe descriptor version 1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "endpoint", "environment", "sideEffects", "assumption", "inputScopes", "cwd", "versionArgs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "endpoint": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "environment": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
    "sideEffects": { "type": "boolean" },
    "assumption": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "inputScopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "cwd": { "type": "string", "minLength": 1 },
    "versionArgs": { "type": "array", "items": { "type": "string", "pattern": "^[^\\u0000]*$" } },
    "timeoutMs": { "type": "integer" }
  }
}
