{
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "runId", "target", "planDigest", "edits", "affectedChecks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "\\S" },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["root", "mode", "revision"],
      "properties": {
        "root": { "type": "string", "pattern": "\\S" },
        "mode": { "enum": ["repo", "workspace"] },
        "revision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "planDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "edits": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "resolvedPath", "originalHash", "proposedHash", "backup", "completed"],
        "properties": {
          "id": { "type": "string", "pattern": "\\S" },
          "path": { "type": "string", "pattern": "\\S" },
          "resolvedPath": { "type": "string", "pattern": "\\S" },
          "originalHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "proposedHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "backup": { "type": ["string", "null"], "pattern": "\\S" },
          "completed": { "type": "boolean" },
          "temporary": { "type": ["string", "null"], "pattern": "\\S" }
        }
      }
    },
    "affectedChecks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "\\S" } }
  }
}
