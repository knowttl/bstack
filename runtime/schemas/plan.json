{
  "title": "Plan record version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "units"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "core", "dependsOn", "design", "boundary", "doneWhen", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "core": { "type": "boolean" },
          "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" } },
          "design": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["location", "state"],
              "properties": {
                "location": { "type": "string", "pattern": "^.+:[1-9][0-9]*$" },
                "state": {
                  "type": "object", "additionalProperties": false,
                  "required": ["kind", "value"],
                  "properties": {
                    "kind": { "enum": ["sha256", "revision"] },
                    "value": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" }
                  }
                }
              }
            }
          },
          "boundary": { "type": "string", "minLength": 1 },
          "doneWhen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "ref"],
              "properties": {
                "kind": { "enum": ["check", "kit-feature"] },
                "ref": { "type": "string", "minLength": 1 },
                "nonFunctionalTarget": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
