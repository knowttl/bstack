{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bstack task evidence version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "slice", "sourceRevision", "intent", "amendments", "status", "environment", "commands", "cases", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "slice": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "intent": { "type": "string", "minLength": 1 },
    "amendments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["passed", "failed", "blocked"] },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "node", "tools"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "tools": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "executable", "args", "cwd", "exitCode", "outputArtifact", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "executable": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "cwd": { "type": "string", "minLength": 1 },
          "exitCode": { "type": ["integer", "null"] },
          "outputArtifact": { "type": ["string", "null"], "minLength": 1 },
          "resultPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "status": { "enum": ["passed", "failed", "blocked"] },
          "reason": { "type": "string", "minLength": 1 },
          "nextPrerequisite": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "blocked" } } },
            "then": { "required": ["reason", "nextPrerequisite"] },
            "else": { "properties": { "exitCode": { "type": "integer" }, "outputArtifact": { "type": "string", "minLength": 1 } } }
          }
        ]
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "procedure", "status", "artifact"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["automated", "agent", "manual"] },
          "procedure": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "blocked"] },
          "artifact": { "type": ["string", "null"], "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "nextPrerequisite": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "blocked" } } },
            "then": { "required": ["reason", "nextPrerequisite"] },
            "else": { "properties": { "artifact": { "type": "string", "minLength": 1 } } }
          }
        ]
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseRevision", "inputs", "suites", "counts", "durationMs", "outputSha256", "eventsSha256", "eventsArtifact"],
      "properties": {
        "postCaptureDocumentation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "before", "after"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "before": { "type": ["object", "null"] },
              "after": { "type": ["object", "null"] }
            }
          }
        },
        "baseRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "sha256"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "files": { "type": "array", "items": {
              "type": "object", "additionalProperties": false, "required": ["path"],
              "properties": { "path": { "type": "string", "minLength": 1 }, "executable": { "type": "boolean" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "deleted": { "const": true } }
            } }
          }
        },
        "suites": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "durationMs": { "type": "number", "minimum": 0 },
        "outputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "eventsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "eventsArtifact": { "type": "string", "minLength": 1 }
      }
    }
  }
}
