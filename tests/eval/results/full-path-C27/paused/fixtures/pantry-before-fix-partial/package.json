{
  "name": "pantry-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test tests/pantry.test.mjs tests/storage.test.mjs",
    "journey": "node scripts/journey.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && npm run journey",
    "start": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "eslint": "9.39.1",
    "typescript-eslint": "8.48.1",
    "prettier": "3.7.4",
    "playwright-core": "1.57.0"
  }
}
