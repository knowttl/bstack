+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import { readFile } from "node:fs/promises";
+import { mkdtemp } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { chromium } from "playwright";
+
+test("approved household browser outcomes", async () => {
+  const evidence = await mkdtemp(join(tmpdir(), "pantry-browser-"));
+  const server = createServer(async (request, response) => {
+    const path = request.url === "/" ? "index.html" : request.url.slice(1);
+    if (
+      !/^(index\.html|dist\/[a-zA-Z0-9/._-]+\.js)$/.test(path) ||
+      path.includes("..")
+    ) {
+      response.writeHead(404);
+      response.end();
+      return;
+    }
+    try {
+      const content = await readFile(path);
+      response.setHeader(
+        "Content-Type",
+        path.endsWith(".js") ? "text/javascript" : "text/html",
+      );
+      response.end(content);
+    } catch {
+      response.writeHead(404);
+      response.end();
+    }
+  });
+  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const browser = await chromium.launch({ channel: "chrome", headless: true });
+  const page = await browser.newPage();
+  const origin = `http://127.0.0.1:${server.address().port}`;
+  const errors = [];
+  page.on("pageerror", (error) => errors.push(error.message));
+  const add = async (name) => {
+    await page.getByLabel("Item name").fill(name);
+    await page.getByRole("button", { name: "Add item" }).click();
+  };
+  try {
+    await page.goto(origin);
+    await add("Rice");
+    await page
+      .getByRole("checkbox", { name: "Rice needed", exact: true })
+      .check();
+    assert.equal(await page.locator("#shopping").innerText(), "Rice");
+    await page.screenshot({ path: join(evidence, "rice-needed.png") });
+    await page.reload();
+    await page
+      .getByRole("checkbox", { name: "Rice needed", exact: true })
+      .waitFor();
+    assert.equal(
+      await page
+        .getByRole("checkbox", { name: "Rice needed", exact: true })
+        .isChecked(),
+      true,
+    );
+    assert.equal(await page.locator("#shopping").innerText(), "Rice");
+    console.log("OBSERVED Rice add -> needed -> shopping -> reload retained");
+    await page.screenshot({ path: join(evidence, "rice-reloaded.png") });
+    await add(" rice ");
+    assert.equal(await page.locator("#pantry li").count(), 1);
+    await add("Brown rice");
+    await add("White rice");
+    assert.equal(await page.locator("#pantry li").count(), 3);
+    await page
+      .getByRole("checkbox", { name: "Rice needed", exact: true })
+      .uncheck();
+    assert.equal(await page.locator("#shopping li").count(), 0);
+    await page.evaluate(() => {
+      globalThis.originalSave = Storage.prototype.setItem;
+      Storage.prototype.setItem = () => {
+        throw new Error("fixture storage failure");
+      };
+    });
+    await add("Milk");
+    await page
+      .getByRole("checkbox", { name: "Milk needed", exact: true })
+      .check();
+    assert.equal(
+      await page.locator("#save-status").innerText(),
+      "Unsaved changes",
+    );
+    assert.match(
+      await page.locator("#message").innerText(),
+      /may be lost on reload/,
+    );
+    assert.equal(await page.locator("#shopping").innerText(), "Milk");
+    await page.getByRole("button", { name: "Retry saving" }).click();
+    assert.equal(
+      await page.locator("#save-status").innerText(),
+      "Unsaved changes",
+    );
+    await page.evaluate(() => {
+      Storage.prototype.setItem = globalThis.originalSave;
+    });
+    await page.getByRole("button", { name: "Retry saving" }).click();
+    assert.equal(
+      await page.locator("#save-status").innerText(),
+      "Saved on this browser",
+    );
+    assert.equal(
+      await page.getByRole("button", { name: "Retry saving" }).isVisible(),
+      false,
+    );
+    await page.reload();
+    await page
+      .getByRole("checkbox", { name: "Milk needed", exact: true })
+      .waitFor();
+    assert.equal(await page.locator("#pantry li").count(), 4);
+    assert.equal(await page.locator("#shopping").innerText(), "Milk");
+    console.log(
+      "OBSERVED duplicate reuse, full-name variants, unmark, failed save, failed retry, complete-session successful retry and reload",
+    );
+    await page.screenshot({ path: join(evidence, "retry-reloaded.png") });
+    await page.evaluate(() =>
+      localStorage.setItem("pantry-list-v1", "invalid JSON"),
+    );
+    await page.reload();
+    await page.locator("#retry").waitFor();
+    assert.equal(
+      await page.locator("#save-status").innerText(),
+      "Unsaved changes",
+    );
+    await add("Tea");
+    assert.equal(await page.locator("#pantry li").count(), 1);
+    await page.getByLabel("Item name").fill("   ");
+    await page.getByRole("button", { name: "Add item" }).click();
+    assert.equal(
+      await page.locator("#message").innerText(),
+      "Enter an item name.",
+    );
+    assert.deepEqual(errors, []);
+    console.log(
+      JSON.stringify({
+        browser: browser.version(),
+        evidence,
+        observed: "real DOM and reload",
+        errors,
+      }),
+    );
+  } finally {
+    await browser.close();
+    await new Promise((resolve) => server.close(resolve));
+  }
+});
