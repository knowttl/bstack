+import type { Item, Persistence } from "../pantry.js";
+const key = "pantry-list-v1";
+export function browserStorage(): Persistence {
+  return {
+    load() {
+      const raw = localStorage.getItem(key);
+      if (raw === null) return [];
+      const parsed: unknown = JSON.parse(raw);
+      if (!Array.isArray(parsed)) throw new Error("Invalid saved list");
+      const items: Item[] = [];
+      for (const entry of parsed) {
+        if (
+          typeof entry !== "object" ||
+          entry === null ||
+          !("name" in entry) ||
+          !("needed" in entry) ||
+          typeof entry.name !== "string" ||
+          typeof entry.needed !== "boolean"
+        )
+          throw new Error("Invalid saved item");
+        const name = entry.name.trim();
+        if (
+          !name ||
+          name.length > 120 ||
+          items.some((item) => item.name.toLowerCase() === name.toLowerCase())
+        )
+          throw new Error("Invalid saved name");
+        items.push({ name, needed: entry.needed });
+      }
+      return items;
+    },
+    save(items) {
+      localStorage.setItem(key, JSON.stringify(items));
+    },
+  };
+}
