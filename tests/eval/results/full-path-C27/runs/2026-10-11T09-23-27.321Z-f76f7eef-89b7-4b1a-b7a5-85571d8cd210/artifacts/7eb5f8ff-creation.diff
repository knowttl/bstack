+        "error",
+        {
+          patterns: [
+            {
+              group: ["**/private/**", "**/storage*"],
+              message: "UI_PRIVATE_STORAGE: use the public pantry interface.",
+            },
+          ],
+        },
+      ],
+      "no-restricted-globals": [
+        "error",
+        {
+          globals: [
+            {
+              name: "localStorage",
+              message: "UI_DIRECT_STORAGE: use the public pantry interface.",
+            },
+          ],
+          checkGlobalObject: true,
+        },
+      ],
+      "no-restricted-properties": [
+        "error",
+        {
+          property: "localStorage",
+          message: "UI_DIRECT_STORAGE: use the public pantry interface.",
+        },
+      ],
+      "no-restricted-syntax": [
+        "error",
+        {
+          selector: "ImportDeclaration[source.value!='../pantry.js']",
+          message:
+            "UI_PUBLIC_ONLY: UI imports only the public pantry interface.",
+        },
+        {
+          selector:
+            "ExportNamedDeclaration[source], ExportAllDeclaration, ImportExpression",
+          message:
+            "UI_PUBLIC_ONLY: UI cannot forward or dynamically import dependencies.",
+        },
