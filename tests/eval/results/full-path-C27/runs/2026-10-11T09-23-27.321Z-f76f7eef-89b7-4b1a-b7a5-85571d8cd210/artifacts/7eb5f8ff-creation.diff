+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>Pantry list</title>
+  </head>
+  <body>
+    <main>
+      <h1>Pantry list</h1>
+      <form id="add-form">
+        <label
+          >Item name <input id="item-name" required maxlength="120" /></label
+        ><button>Add item</button>
+      </form>
+      <p id="message" role="alert"></p>
+      <p id="save-status" role="status"></p>
+      <button id="retry" type="button" hidden>Retry saving</button>
+      <h2>Pantry</h2>
+      <ul id="pantry"></ul>
+      <h2>Shopping list</h2>
+      <ul id="shopping"></ul>
+    </main>
+    <script type="module" src="./dist/main.js"></script>
+  </body>
+</html>
