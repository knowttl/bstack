+export interface Item {
+  name: string;
+  needed: boolean;
+}
+export interface Persistence {
+  load(): Item[];
+  save(items: readonly Item[]): void;
+}
+export interface Snapshot {
+  items: readonly Item[];
+  saved: boolean;
+  message: string;
+}
+export function createPantry(storage: Persistence) {
+  let items: Item[] = [];
+  let saved = true;
+  let message = "";
+  try {
+    items = storage.load();
+  } catch {
+    saved = false;
+    message =
+      "Could not read saved items. Changes are unsaved until saving works.";
+  }
+  function save() {
+    try {
+      storage.save(items);
+      saved = true;
+      message = "";
+    } catch {
+      saved = false;
+      message = "Saving failed. Changes are unsaved and may be lost on reload.";
+    }
+  }
+  return {
+    snapshot(): Snapshot {
+      return { items: items.map((item) => ({ ...item })), saved, message };
+    },
+    add(raw: string) {
+      const name = raw.trim();
+      if (!name) return "Enter an item name.";
+      if (name.length > 120) return "Use at most 120 characters.";
+      if (!items.some((item) => item.name.toLowerCase() === name.toLowerCase()))
+        items.push({ name, needed: false });
+      save();
+      return "";
+    },
+    setNeeded(name: string, needed: boolean) {
+      const item = items.find((item) => item.name === name);
+      if (item) {
+        item.needed = needed;
+        save();
+      }
+    },
+    retry: save,
+  };
+}
+export type Pantry = ReturnType<typeof createPantry>;
