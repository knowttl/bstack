    "documents": [
      {
        "id": "design",
        "path": "DESIGN.md",
        "assessment": {
          "result": "no-impact",
          "changedBehavior": "Name unitPrice * quantity as undiscountedTotal, then apply the identical quantity > 5 ? 0.9 : 1 factor; imports, default unit price, order recording and returned status/total remain unchanged.",
          "changedPaths": [
            "packages/web/routes.ts"
          ],
          "reason": "The diff extracts only the existing first multiplication, preserving JavaScript's left-to-right evaluation and the existing discount factor. It retains the public core import and adds no dependency edge, so UI/storage separation and acyclicity remain true. Public quote stays 12 and default checkout stays { status: 201, total: 10 }, as captured by passing original and compatibility npm run check runs (including real loopback HTTP). No acceptance, public signature, receipt wording or responsibility changes are required.",
          "citations": [
            {
              "path": "DESIGN.md",
              "pointer": "The UI never touches storage.",
              "version": "current"
            },
