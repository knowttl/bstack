Ids\": [\n-        \"storage-interface\",\n-        \"checkout-total\",\n-        \"acyclic\",\n-        \"final-evidence\"\n-      ]\n-    },\n-    {\n-      \"path\": \"packages/web/alias.ts\",\n-      \"scopeIds\": [\n-        \"project\"\n-      ],\n-      \"documentIds\": [\n-        \"design\",\n-        \"terms\",\n-        \"instructions\"\n-      ],\n-      \"ruleIds\": [\n-        \"storage-interface\",\n-        \"checkout-total\",\n-        \"acyclic\",\n-        \"final-evidence\"\n-      ]\n-    },\n-    {\n-      \"path\": \"packages/web/routes.ts\",\n-      \"scopeIds\": [\n-        \"project\"\n-      ],\n-      \"documentIds\": [\n-        \"design\",\n-        \"terms\",\n-        \"instructions\"\n-      ],\n-      \"ruleIds\": [\n-        \"storage-interface\",\n-        \"checkout-total\",\n-        \"acyclic\",\n-        \"final-evidence\"\n-      ]\n-    },\n-    {\n-      \"path\": \"packages/web/ui.ts\",\n-      \"scopeIds\": [\n-        \"project\"\n-      ],\n-      \"documentIds\": [\n-        \"design\",\n-        \"terms\",\n-        \"instructions\"\n-      ],\n-      \"ruleIds\": [\n-        \"storage-interface\",\n-        \"checkout-total\",\n-        \"acyclic\",\n-        \"final-evidence\"\n-      ]\n-    }\n-  ],\n-  \"unmappedPaths\": [],\n-  \"documents\": [\n-    {\n-      \"id\": \"design\",\n-      \"path\": \"DESIGN.md\",\n-      \"assessment\": {\n-        \"result\": \"updated\",\n-        \"changedBehavior\": \"Approved storage prohibition and total10 are preserved. The endpoint is corrected to10 without changing assertion10; quote12 and quantity formula remain. Core now owns order storage and exports servicePrice/postOrder; cycle is removed. Added completion and portable-impact guidance records the selected native checks and historical snapshot policy. The uncommitted receipt note is preserved exactly and receipt wording remains deferred.\",\n-        \"changedPaths\": [\n-          \".bstack/bin/bstack-check.mjs\",\n-          \".bstack/project.json\",\n-          \".bstack/schemas/check-plan.json\",\n-          \".bstack/schemas/evidence.schema.json\",\n-          \".bstack/schemas/impact-assessment.json\",\n-          \".bstack/schemas/project.schema.json\",\n-          \"AGENTS.md\",\n-          \"DESIGN.md\",\n-          \"docs/repo-audit.md\",\n-          \"glossary.md\",\n-          \"journey.mjs\",\n-          \"package.json\",\n-          \"packages/core/b.ts\",\n-          \"packages/core/index.ts\",\n-          \"packages/core/internal/database.ts\",\n-          \"packages/web/alias.ts\",\n-          \"packages/web/routes.ts\",\n-          \"packages/web/ui.ts\"\n-        ],\n-        \"reason\": \"Approved storage prohibition and total10 are preserved. The endpoint is corrected to10 without changing assertion10; quote12 and quantity formula remain. Core now owns order storage and exports servicePrice/postOrder; cycle is removed. Added completion and portable-impact guidance records the selected native checks and historical snapshot policy. The uncommitted receipt note is preserved exactly and receipt wording remains deferred.\",\n-        \"citations\": [\n-          {\n-            \"path\": \"DESIGN.md\",\n-            \"pointer\": \"# Shop design\\n\\nThe UI never touches storage.\\nThe agreed checkout total is 10.\",\n-            \"version\": \"base\"\n-          },\n-          {\n-            \"path\": \"DESIGN.md\",\n-            \"pointer\": \"# Shop design\\n\\nThe UI never touches storage.\\nThe agreed checkout total is 10.\\n\\nUser note: receipt wording remains a future owner decision.\\n\\n## Responsibilities and public interface\\n\\nWeb consumers use the public core interface in packages/core/index.ts (also exported as @shop/core). Storage access and the order list belong to core; web routes may forward the public postOrder function. Core implementation modules may import core storage. The native static dependency graph must be acyclic. No boundary or cycle exceptions are accepted.\\n\\nFor example, a web consumer can use the public interface without importing storage:\\n\\n```ts\\nimport { servicePrice, postOrder } from '@shop/core'\\nexport async function checkout(url: string, quantity = 1) {\\n  return postOrder(quantity, await servicePrice(url))\\n}\\n```\\n\\nThe controlled HTTP endpoint in journey.mjs supplies price 10; checkout must return { status: 201, total: 10 } for the default quantity. Public quote() continues to return 12. The existing quantity calculation is retained; no new business discount is introduced. Receipt wording is outside this correction.\\n\\n## Checks and completion evidence\\n\\nInstall the locked development dependencies with npm ci using Node 24 or later. Run npm run check: TypeScript, unit tests, native boundaries and the real local HTTP journey must all pass. package.json owns the commands; boundaries.mjs owns static import/export resolution and cycle detection. The boundary check does not cover dynamic imports or every transitive facade leak; review new dependency syntax against the public-interface rule.\\n\\nAcceptance cases live in this design, unit.test.mjs and journey.mjs. A change is complete when its affected journeys pass on the final inputs and authoritative-source impacts have been reviewed. Passing unit tests alone does not establish journey completion. For structural changes, capture passing public compatibility checks before and after; for bug fixes, retain the original failing reproduction and the final passing outcome. No hosted CI or delivery service is selected.\\n\\n## Maintenance contract and portable assessment\\n\\n.bstack/project.json maps paths to these rules and to DESIGN.md, glossary.md and AGENTS.md. For every change, compare against an explicit ancestor commit, inspect the diff and assess every mapped document and unmapped path. Record changed behavior, changed paths, a substantive reason, literal base/current source citations and any dependent work. Use updated with the actual before/after excerpt, no-impact with the preserved invariant, or decision-needed and stop dependent work. Keep correct sources unchanged and preserve user edits. Acceptance changes require a separate owner approval; never change an expectation to excuse a failure.\\n\\nCommit reviewed implementation first. Prepare .bstack/assessment.json against that implementation commit and explicit base using the bundled evidence schema; include reviewed coverage and bind the current fingerprint. Commit only that assessment afterward. Keep execution captures outside product scopes. The selected first-contract foundation finding and its protected-write record must be retained in the assessment. The assessment is the explicit review record, not an activity log.\\n\\nRun the complete dependency-free checker from this checkout:\\n\\n```sh\\nnode .bstack/bin/bstack-check.mjs --repo . --base <ancestor-commit> --assessment .bstack/assessment.json --json\\n```\\n\\nIt validates assessment coverage, runs required native checks freshly, then revalidates. Run it again in a different-root clean clone with an isolated home and cache and the same base and committed assessment. Failed, missing or stale evidence leaves the change unverified. Contract/checker changes preserve previous coverage or require a reviewed migration.\\n\\nThe versioned docs/repo-audit.md is a historical snapshot of its stated observed revision. It is not a live readiness authority. Keep final current-head findings and readiness evidence in scratch rather than rewriting that snapshot after each checker invocation. A later user edit requires fresh affected evidence and impact review.\",\n-            \"version\": \"current\"\n-          }\n-        ],\n-        \"dependentWork\": [],\n-        \"delta\": {\n-          \"before\": \"\",\n-          \"after\": \"The native static dependency graph must be acyclic.\"\n-        }\n-      }\n-    },\n-    {\n-      \"id\": \"terms\",\n-      \"path\": \"glossary.md\",\n-      \"assessment\": {\n-        \"result\": \"updated\",\n-        \"changedBehavior\": \"Purchase remains Order. The selected presentation meaning is renamed Panel order, eliminating two incompatible Order definitions. Code paths and public exports do not gain a new business meaning.\",\n-        \"changedPaths\": [\n-          \".bstack/bin/bstack-check.mjs\",\n-          \".bstack/project.json\",\n-          \".bstack/schemas/check-plan.json\",\n-          \".bstack/schemas/evidence.schema.json\",\n-          \".bstack/schemas/impact-assessment.json\",\n-          \".bstack/schemas/project.schema.json\",\n-          \"AGENTS.md\",\n-          \"DESIGN.md\",\n-          \"docs/repo-audit.md\",\n-          \"glossary.md\",\n-          \"journey.mjs\",\n-          \"package.json\",\n-          \"packages/core/b.ts\",\n-          \"packages/core/index.ts\",\n-          \"packages/core/internal/database.ts\",\n-          \"packages/web/alias.ts\",\n-          \"packages/web/routes.ts\",\n-          \"packages/web/ui.ts\"\n-        ],\n-        \"reason\": \"Purchase remains Order. The selected presentation meaning is renamed Panel order, eliminating two incompatible Order definitions. Code paths and public exports do not gain a new business meaning.\",\n-        \"citations\": [\n-          {\n-            \"path\": \"glossary.md\",\n-            \"pointer\": \"# Glossary\\n\\nOrder: a customer purchase.\\nOrder: the sequence in which UI panels appear.\",\n-            \"version\": \"base\"\n-          },\n-          {\n-            \"path\": \"glossary.md\",\n-            \"pointer\": \"# Glossary\\n\\nOrder: a customer purchase.\\nPanel order: the sequence in which UI panels appear.\",\n-            \"version\": \"current\"\n-          }\n-        ],\n-        \"dependentWork\": [],\n-        \"delta\": {\n-          \"before\": \"# Glossary\\n\\nOrder: a customer purchase.\\nOrder: the sequence in which UI panels appear.\",\n-          \"after\": \"# Glossary\\n\\nOrder: a customer purchase.\\nPanel order: the sequence in which UI panels appear.\"\n-        }\n-      }\n-    },\n-    {\n-      \"id\": \"instructions\",\n-      \"path\": \"AGENTS.md\",\n-      \"assessment\": {\n-        \"result\": \"updated\",\n-        \"changedBehavior\": \"Existing approved design/public-interface instruction becomes maintained pointers to DESIGN.md and glossary.md, native aggregate command and contract. Distinct CLAUDE.md import stub is retained; no instruction-loading migration or hosted delivery is implied.\",\n-        \"changedPaths\": [\n-          \".bstack/bin/bstack-check.mjs\",\n-          \".bstack/project.json\",\n-          \".bstack/schemas/check-plan.json\",\n-          \".bstack/schemas/evidence.schema.json\",\n-          \".bstack/schemas/impact-assessment.json\",\n-          \".bstack/schemas/project.schema.json\",\n-          \"AGENTS.md\",\n-          \"DESIGN.md\",\n-          \"docs/repo-audit.md\",\n-          \"glossary.md\",\n-          \"journey.mjs\",\n-          \"package.json\",\n-          \"packages/core/b.ts\",\n-          \"packages/core/index.ts\",\n-          \"packages/core/internal/database.ts\",\n-          \"packages/web/alias.ts\",\n-          \"packages/web/routes.ts\",\n-          \"packages/web/ui.ts\"\n-        ],\n-        \"reason\": \"Existing approved design/public-interface instruction becomes maintained pointers to DESIGN.md and glossary.md, native aggregate command and contract. Distinct CLAUDE.md import stub is retained; no instruction-loading migration or hosted delivery is implied.\",\n-        \"citations\": [\n-          {\n-            \"path\": \"AGENTS.md\",\n-            \"pointer\": \"Use the approved design and public core interface.\",\n-            \"version\": \"base\"\n-          },\n-          {\n-            \"path\": \"AGENTS.md\",\n-            \"pointer\": \"Use [DESIGN.md](DESIGN.md) for approved responsibilities, the public core example, acceptance cases and change evidence. Use [glossary.md](glossary.md) for project terms.\\n\\nRun `npm run check` for the maintained native checks. Follow the maintenance contract in [.bstack/project.json](.bstack/project.json) and the standalone assessment check documented in DESIGN.md. Preserve user work; receipt wording remains a future owner decision.\",\n-            \"version\": \"current\"\n-          }\n-        ],\n-        \"dependentWork\": [],\n-        \"delta\": {\n-          \"before\": \"Use the approved design and public core interface.\",\n-          \"after\": \"Use [DESIGN.md](DESIGN.md) for approved responsibilities, the public core example, acceptance cases and change evidence. Use [glossary.md](glossary.md) for project terms.\\n\\nRun `npm run check` for the maintained native checks. Follow the maintenance contract in [.bstack/project.json](.bstack/project.json) and the standalone assessment check documented in DESIGN.md. Preserve user work; receipt wording remains a future owner decision.\"\n-        }\n-      }\n-    }\n-  ],\n-  \"unmappedAssessments\": [],\n-  \"decisions\": [\n-    {\n-      \"id\": \"checkout-source-maintenance\",\n-      \"status\": \"approved\",\n-      \"source\": \"DESIGN.md\",\n-      \"oldCase\": \"The agreed checkout total is 10.\",\n-      \"newCase\": \"The agreed checkout total is 10.\",\n-      \"affectedWork\": [\n-        \"journey.mjs\",\n-        \"DESIGN.md\"\n-      ],\n-      \"approval\": {\n-        \"path\": \"docs/repo-audit.md\",\n-        \"pointer\": \"Supervisor-selected fixture verdicts, 2026-10-11: Correct the controlled journey endpoint fixture to supply 10, preserve the assertion at 10 and current quote behaviour at 12, and invent no business discount. Keep Order for purchases and rename panel sequencing to Panel order.\",\n-        \"version\": \"current\"\n-      }\n-    },\n-    {\n-      \"id\": \"quote-source-maintenance\",\n-      \"status\": \"approved\",\n-      \"source\": \"DESIGN.md\",\n- 