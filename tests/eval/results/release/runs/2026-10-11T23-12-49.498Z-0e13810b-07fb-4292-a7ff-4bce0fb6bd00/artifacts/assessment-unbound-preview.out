{"schemaVersion":1,"command":"apply","status":"passed","problems":[],"data":{"planDigest":"42527944fe1d2d84048f3746bd21644b7987c611a3e86fd651a90c28bf06c22d","dryRun":true,"edits":[{"id":"assessment-unbound","path":".bstack/assessment.json","originalHash":"b1db25670e907cc077ed9b03167c08b712da74208f05561a41c0596ddc4619ed","proposedHash":"88d01e5eec9741d25b237e9a0645f456a36ef6e5c3cfd65be24bb1a87a156044","proposedContent":"{\n  \"schemaVersion\": 1,\n  \"repo\": \".\",\n  \"contract\": \".bstack/project.json\",\n  \"previousContract\": \".bstack/project.json\",\n  \"base\": {\n    \"ref\": \"156e8342bc33bb6ce7c7713c4df1735eeb13aa05\",\n    \"kind\": \"commit\",\n    \"objectId\": \"156e8342bc33bb6ce7c7713c4df1735eeb13aa05\"\n  },\n  \"head\": \"cd0867a247ef1ea23eddc3a4d8c860a7613c91a9\",\n  \"changes\": [\n    {\n      \"source\": \"committed\",\n      \"status\": \"M\",\n      \"path\": \"packages/core/internal/database.ts\"\n    }\n  ],\n  \"paths\": [\n    \"packages/core/internal/database.ts\"\n  ],\n  \"mappings\": [\n    {\n      \"path\": \"packages/core/internal/database.ts\",\n      \"scopeIds\": [\n        \"project\"\n      ],\n      \"documentIds\": [\n        \"design\",\n        \"terms\",\n        \"instructions\"\n      ],\n      \"ruleIds\": [\n        \"storage-interface\",\n        \"checkout-total\",\n        \"acyclic\",\n        \"final-evidence\"\n      ]\n    }\n  ],\n  \"unmappedPaths\": [],\n  \"documents\": [\n    {\n      \"id\": \"design\",\n      \"path\": \"DESIGN.md\",\n      \"assessment\": {\n        \"result\": \"no-impact\",\n        \"changedBehavior\": \"No public behavior changes: name the unit-price times quantity intermediate, retaining the quantity factor and arithmetic order.\",\n        \"changedPaths\": [\n          \"packages/core/internal/database.ts\"\n        ],\n        \"reason\": \"The existing pricing multiplication now names subtotal = unitPrice * quantity, then applies the same quantity > 5 factor in the same order. Quote remains 12 and default real HTTP checkout remains status201,total10, proven by before/after native captures. No exports, imports, persistence or graph edges change; storage remains in core and acyclicity remains checked. Acceptance sources and both user notes remain byte-identical.\",\n        \"citations\": [\n          {\n            \"path\": \"DESIGN.md\",\n            \"pointer\": \"The existing quantity calculation is retained; no new business discount is introduced.\",\n            \"version\": \"base\"\n          },\n          {\n            \"path\": \"DESIGN.md\",\n            \"pointer\": \"The existing quantity calculation is retained; no new business discount is introduced.\",\n            \"version\": \"current\"\n          }\n        ],\n        \"dependentWork\": []\n      }\n    },\n    {\n      \"id\": \"terms\",\n      \"path\": \"glossary.md\",\n      \"assessment\": {\n        \"result\": \"no-impact\",\n        \"changedBehavior\": \"No public behavior changes: name the unit-price times quantity intermediate, retaining the quantity factor and arithmetic order.\",\n        \"changedPaths\": [\n          \"packages/core/internal/database.ts\"\n        ],\n        \"reason\": \"Naming a local arithmetic subtotal does not add or rename a domain concept: Order still denotes a customer purchase; Panel order still denotes UI panel sequence. No glossary entries or public names change.\",\n        \"citations\": [\n          {\n            \"path\": \"glossary.md\",\n            \"pointer\": \"Order: a customer purchase.\\nPanel order: the sequence in which UI panels appear.\",\n            \"version\": \"base\"\n          },\n          {\n            \"path\": \"glossary.md\",\n            \"pointer\": \"Order: a customer purchase.\\nPanel order: the sequence in which UI panels appear.\",\n            \"version\": \"current\"\n          }\n        ],\n        \"dependentWork\": []\n      }\n    },\n    {\n      \"id\": \"instructions\",\n      \"path\": \"AGENTS.md\",\n      \"assessment\": {\n        \"result\": \"no-impact\",\n        \"changedBehavior\": \"No public behavior changes: name the unit-price times quantity intermediate, retaining the quantity factor and arithmetic order.\",\n        \"changedPaths\": [\n          \"packages/core/internal/database.ts\"\n        ],\n        \"reason\": \"The only implementation edit is a local subtotal in core storage implementation. The approved design/glossary pointers and maintained npm run check remain accurate and unchanged; before/after native captures and fresh standalone checks enforce the same completion process. Receipt wording remains deferred.\",\n        \"citations\": [\n          {\n            \"path\": \"AGENTS.md\",\n            \"pointer\": \"Run `npm run check` for the maintained native checks.\",\n            \"version\": \"base\"\n          },\n          {\n            \"path\": \"AGENTS.md\",\n            \"pointer\": \"Run `npm run check` for the maintained native checks.\",\n            \"version\": \"current\"\n          }\n        ],\n        \"dependentWork\": []\n      }\n    }\n  ],\n  \"unmappedAssessments\": [],\n  \"decisions\": [],\n  \"coverage\": [\n    \"storage-interface\",\n    \"checkout-total\",\n    \"acyclic\",\n    \"final-evidence\"\n  ],\n  \"execution\": [\n    {\n      \"runId\": \"eb421b1c-8fb7-4baa-9574-801da8e9265a\",\n      \"plan\": \"[isolated-home][scratch-path]\"\n    }\n  ],\n  \"fingerprint\": null,\n  \"foundation\": {\n    \"findingId\": \"F-006\",\n    \"record\": {\n      \"schemaVersion\": 1,\n      \"stage\": \"foundation\",\n      \"target\": {\n        \"mode\": \"repo\",\n        \"root\": \"[scratch-path]\",\n        \"revision\": \"df0289b0424e4920a94ae80a38aa1141a1a11cda\"\n      },\n      \"nextChange\": \"Finish the existing-repo final checkpoint, then support a user edit/re-audit and representative extension from maintained guidance.\",\n      \"reviewedScope\": [\n        \".bstack/assessment.json\",\n        \".bstack/bin/bstack-check.mjs\",\n        \".bstack/project.json\",\n        \".bstack/schemas/check-plan.json\",\n        \".bstack/schemas/evidence.schema.json\",\n        \".bstack/schemas/impact-assessment.json\",\n        \".bstack/schemas/project.schema.json\",\n        \"AGENTS.md\",\n        \"DESIGN.md\",\n        \"boundaries.mjs\",\n        \"docs/repo-audit.md\",\n        \"glossary.md\",\n        \"journey.mjs\",\n        \"package.json\",\n        \"packages/core/a.ts\",\n        \"packages/core/b.ts\",\n        \"packages/core/index.ts\",\n        \"packages/core/internal/database.ts\",\n        \"packages/web/alias.ts\",\n        \"packages/web/routes.ts\",\n        \"packages/web/ui.ts\"\n      ],\n      \"sources\": [\n        {\n          \"id\": \"design\",\n          \"pointer\": \"DESIGN.md:3\",\n          \"intent\": \"documented\",\n          \"summary\": \"UI never touches storage; checkout total10 at line4.\"\n        },\n        {\n          \"id\": \"instructions\",\n          \"pointer\": \"AGENTS.md:1\",\n          \"intent\": \"documented\",\n          \"summary\": \"Use approved design and public core interface.\"\n        },\n        {\n          \"id\": \"checks\",\n          \"pointer\": \"package.json:12\",\n          \"intent\": \"observed\",\n          \"summary\": \"Aggregate check currently runs types only; separate journey and boundaries exist.\"\n        },\n        {\n          \"id\": \"journey\",\n          \"pointer\": \"journey.mjs:6\",\n          \"intent\": \"observed\",\n          \"summary\": \"HTTP service gives12, checkout must return201,total10; actual native run fails with12.\"\n        },\n        {\n          \"id\": \"graph\",\n          \"pointer\": \"boundaries.mjs:19\",\n          \"intent\": \"observed\",\n          \"summary\": \"Native graph run exits1 with alias,cycle,private.\"\n        },\n        {\n          \"id\": \"terms\",\n          \"pointer\": \"glossary.md:3\",\n          \"intent\": \"documented\",\n          \"summary\": \"Order defined twice: purchase and UI panel sequence.\"\n        },\n        {\n          \"id\": \"public\",\n          \"pointer\": \"packages/web/public.ts:1\",\n          \"intent\": \"observed\",\n          \"summary\": \"Existing public core index import example; current quote12 is observed unit expectation, not approved checkout acceptance.\"\n        },\n        {\n          \"id\": \"proposal\",\n          \"pointer\": \"DESIGN.md:3\",\n          \"intent\": \"inferred\",\n          \"summary\": \"Keeping pricing and order storage behind core is a proposed responsibility allocation derived from no-UI-storage constraint.\"\n        },\n        {\n          \"id\": \"selection\",\n          \"pointer\": \"DESIGN.md:6\",\n          \"intent\": \"documented\",\n          \"summary\": \"User note is preserved exactly; supervisor selected endpoint10/quote12, Panel order, public core, cycle enforcement, maintained foundation, historical snapshot semantics. Approval retained in scratch shop-selection.txt.\"\n        }\n      ],\n      \"findings\": [\n        {\n          \"id\": \"F-001\",\n          \"problem\": \"Real HTTP checkout returns12, violating agreed total10.\",\n          \"files\": [\n            \"journey.mjs\"\n          ],\n          \"command\": \"npm run journey\",\n          \"principle\": \"Honor the approved checkout total10.\",\n          \"consequence\": \"Unit mock success conceals the failing actual fetch journey.\",\n          \"fix\": \"Correct the controlled journey endpoint fixture to supply10, keep expected10 and public quote12, and invent no business discount.\",\n          \"scope\": [\n            \"journey.mjs\"\n          ],\n          \"verification\": \"Original failing reproduction, unchanged real HTTP journey passes with total10; surrounding public quote remains covered.\",\n          \"blocksNextChange\": true,\n          \"category\": \"debt\",\n          \"status\": \"selected\",\n          \"newPrinciple\": false,\n          \"resolved\": false,\n          \"sourceIds\": [\n            \"design\",\n            \"journey\",\n            \"selection\"\n          ]\n        },\n        {\n          \"id\": \"F-002\",\n          \"problem\": \"UI imports storage directly and through alias; routes owns mutable order storage.\",\n          \"files\": [\n            \"packages/core/index.ts\",\n            \"packages/core/internal/database.ts\",\n            \"packages/web/ui.ts\",\n            \"packages/web/routes.ts\",\n            \"packages/web/alias.ts\",\n            \"DESIGN.md\"\n          ],\n          \"command\": \"npm run boundaries\",\n          \"principle\": \"UI never touches storage; consumers use public core interface.\",\n          \"consequence\": \"Storage details leak into UI and obstruct a representative extension through public guidance.\",\n          \"fix\": \"Route UI and alias consumers through core index; place order persistence behind core. Add a representative approved public-interface example in DESIGN.md, preserving current exported web functions.\",\n          \"scope\": [\n            \"packages/core/index.ts\",\n            \"packages/core/internal/database.ts\",\n            \"packages/web/ui.ts\",\n            \"packages/web/routes.ts\",\n            \"packages/web/alias.ts\",\n            \"DESIGN.md\"\n          ],\n          \"verification\": \"Capture original-state public compatibility; clean public imports pass, separate private and alias seeds fail native rule-proof; sibling core internal use remains permitted.\",\n          \"blocksNextChange\": true,\n          \"category\": \"debt\",\n          \"status\": \"selected\",\n          \"newPrinciple\": false,\n          \"resolved\": false,\n          \"sourceIds\": [\n            \"design\",\n            \"instructions\",\n            \"public\",\n            \"proposal\"\n          ]\n        },\n        {\n          \"id\": \"F-003\",\n          \"problem\": \"Core a and b form a recursive cycle flagged by the native checker.\",\n          \"files\": [\n            \"packages/core/a.ts\",\n            \"packages/core/b.ts\"\n          ],\n          \"command\": \"npm run boundaries\",\n          \"principle\": \"Proposed adoption of the existing checker's acyclic graph rule.\",\n          \"consequence\": \"Calling either function recurses without terminating; aggregate check currently misses it.\",\n          \"fix\": \"Select acyclic enforcement and remove this unused cycle while preserving exported function names, with reviewed terminating behavior.\",\n          \"scope\": [\n            \"packages/core/a.ts\",\n            \"packages/core/b.ts\"\n          ],\n          \"verification\": \"Native clean boundary check and independent cycle violation proof; owner review of new terminating behavior.\",\n          \"blocksNextChange\": true,\n          \"category\": \"debt\",\n          \"status\": \"selected\",\n          \"newPrinciple\": true,\n          \"resolved\": false,\n          \"sourceIds\": [\n            \"graph\"\n          ]\n        },\n        {\n          \"id\": \"F-004\",\n          \"problem\": \"Order has incompatible definitions.\",\n          \"files\": [\n            \"glossary.md\"\n          ],\n          \"command\": null,\n          \"principle\": \"One resolved meaning per canonical domain term.\",\n          \"consequence\": \"Future extension cannot rely unambiguously on repo language.\",\n          \"fix\": \"Retain Order for purchases; rename the presentation concept to Panel order in existing glossary.md.\",\n          \"scope\": [\n            \"glossary.md\"\n          ],\n          \"verification\": \"Owner chooses terms, then reviewed exact glossary diff and contract coverage.\",\n          \"blocksNextChange\": true,\n          \"category\": \"decision\",\n          \"status\": \"selected\",\n          \"newPrinciple\": true,\n          \"resolved\": true,\n          \"sourceIds\": [\n            \"terms\",\n            \"selection\"\n          ]\n        },\n        {\n          \"id\": \"F-005\",\n          \"problem\": \"Maintained check currently runs types only and omits the failing native boundary and HTTP journey checks.\",\n          \"files\": [\n            \"package.json\",\n            \"boundaries.mjs\"\n          ],\n          \"command\": \"npm run check\",\n          \"principle\": \"Proposed final-input journey evidence and maintained authoritative-source impact review.\",\n          \"consequence\": \"Green types/unit checks do not prevent agreed journey failures or guide later maintenance.\",\n          \"fix\": \"Extend the existing check command with fail-fast types, tests, boundaries and real HTTP journey; prove native boundary rules independently and through that aggregate.\",\n          \"scope\": [\n            \"package.json\",\n            \"boundaries.mjs\"\n          ],\n          \"verification\": \"Native valid/private/alias/cycle controls and maintained aggregate controls; final native capture on applied inputs.\",\n          \"blocksNextChange\": true,\n          \"category\": \"missing-protection\",\n          \"status\": \"selected\",\n          \"newPrinciple\": true,\n          \"resolved\": false,\n          \"sourceIds\": [\n            \"design\",\n            \"checks\",\n            \"instructions\"\n          ]\n        },\n        {\n          \"id\": \"F-006\",\n          \"problem\": \"No maintained source-impact contract, complete standalone assessment checker or portable review record exists.\",\n          \"files\": [\n            \"DESIGN.md\",\n            \"AGENTS.md\",\n            \".bstack/project.json\",\n            \".bstack/bin/bstack-check.mjs\",\n            \".bstack/assessment.json\",\n            \"docs/repo-audit.md\",\n            \".bstack/schemas/check-plan.json\",\n            \".bstack/schemas/evidence.schema.json\",\n            \".bstack/schemas/impact-assessment.json\",\n            \".bstack/schemas/project.schema.json\"\n          ],\n          \"command\": \"npm run check\",\n          \"principle\": \"Proposed final-input journey evidence and maintained authoritative-source impact review.\",\n          \"consequence\": \"Green types/unit checks do not prevent agreed journey failures or guide later maintenance.\",\n          \"fix\": \"Create selected first-contract foundation, install the complete dependency-free checker unchanged with maintenance schemas, add public-interface and maintenance guidance; retain a historical versioned audit snapshot and current-head readiness in scratch. Collect and review final portable assessment after implementation, then prove the unchanged record in an isolated different-root clone.\",\n          \"scope\": [\n            \"DESIGN.md\",\n            \"AGENTS.md\",\n            \".bstack/project.json\",\n            \".bstack/bin/bstack-check.mjs\",\n            \".bstack/assessment.json\",\n            \"docs/repo-audit.md\",\n            \".bstack/schemas/check-plan.json\",\n            \".bstack/schemas/evidence.schema.json\",\n            \".bstack/schemas/impact-assessment.json\",\n            \".bstack/schemas/project.schema.json\"\n          ],\n          \"verification\": \"Contract/docs validation, complete assessed final change coverage, first-foundation protected record, fresh standalone checker locally and in a different-root clean clone with isolated home/cache and explicit base.\",\n          \"blocksNextChange\": true,\n          \"category\": \"missing-protection\",\n          \"status\": \"selected\",\n          \"newPrinciple\": true,\n          \"resolved\": false,\n          \"sourceIds\": [\n            \"design\",\n            \"checks\",\n            \"instructions\",\n            \"selection\"\n          ]\n        }\n      ],\n      \"selectedFindingIds\": [\n        \"F-001\",\n        \"F-002\",\n        \"F-003\",\n        \"F-004\",\n   