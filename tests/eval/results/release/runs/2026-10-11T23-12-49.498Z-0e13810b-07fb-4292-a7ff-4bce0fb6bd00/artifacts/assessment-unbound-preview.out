"\n+      ]\n+    }\n+  }\n+}\n"}],"diff":"--- a/.bstack/assessment.json\n+++ b/.bstack/assessment.json\n@@ -1,917 +1,435 @@\n-{\n-  \"schemaVersion\": 1,\n-  \"repo\": \".\",\n-  \"contract\": \".bstack/project.json\",\n-  \"previousContract\": null,\n-  \"base\": {\n-    \"ref\": \"b6c59b7810f5155fd514c9db60e98b7dffce0cc0\",\n-    \"kind\": \"commit\",\n-    \"objectId\": \"b6c59b7810f5155fd514c9db60e98b7dffce0cc0\"\n-  },\n-  \"head\": \"df0289b0424e4920a94ae80a38aa1141a1a11cda\",\n-  \"changes\": [\n-    {\n-      \"source\": \"committed\",\n-      \"status\": \"A\",\n-      \"path\": \".bstack/bin/bstack-check.mjs\"\n-    },\n-    {\n-      \"source\": \"committed\",\n-      \"status\": \"A\",\n-      \"path\": \".bstack/project.json\"\n-    },\n-    {\n-      \"source\": \"committed\",\n-      \"status\": \"A\",\n-      \"path\": \".bstack/schemas/check-plan.json\"\n-    },\n-    {\n-      \"source\": \"committed\",\n-      \"status\": \"A\",\n-      \"path\": \".bstack/schemas/evidence.schema.json\"\n-    },\n-    {\n-      \"source\": \"committed\",\n-      \"status\": \"A\",\n-      \"path\": \".bstack/schemas/impact-assessment.json\"\n-    },\n-    {\n-      \"source\": \"committed\",\n-      \"status\": \"A\",\n-      \"path\": \".bstack/schemas/project.schema.json\"\n-    },\n-    {\n-      \"source\": \"committed\",\n-      \"status\": \"M\",\n-      \"path\": \"AGENTS.md\"\n-    },\n-    {\n-      \"source\": \"committed\",\n-      \"status\": \"M\",\n-      \"path\": \"DESIGN.md\"\n-    },\n-    {\n-      \"source\": \"committed\",\n-      \"status\": \"A\",\n-      \"path\": \"docs/repo-audit.md\"\n-    },\n-    {\n-      \"source\": \"committed\",\n-      \"status\": \"M\",\n-      \"path\": \"glossary.md\"\n-    },\n-    {\n-      \"source\": \"committed\",\n-      \"status\": \"M\",\n-      \"path\": \"journey.mjs\"\n-    },\n-    {\n-      \"source\": \"committed\",\n-      \"status\": \"M\",\n-      \"path\": \"package.json\"\n-    },\n-    {\n-