+      }
+      webRecorded++
+    }
+  }
+  if (problems.length) throw new CommandError('failed', problems)
+  return { inputs: { target, report: options.report }, data: { mode: report.mode, filesChecked, webRecorded, webVerifiedByChecker: false } }
+}
