+import ts from 'typescript'
+import { relative, resolve, sep } from 'node:path'
+const root = process.cwd()
+const config = ts.readConfigFile('tsconfig.json', ts.sys.readFile)
+if (config.error) throw new Error(ts.flattenDiagnosticMessageText(config.error.messageText, '\n'))
+const parsed = ts.parseJsonConfigFileContent(config.config, ts.sys, root)
+if (parsed.errors.length) throw new Error(ts.formatDiagnosticsWithColorAndContext(parsed.errors, {
+  getCanonicalFileName: name => name, getCurrentDirectory: () => root, getNewLine: () => '\n'
+}))
+const program = ts.createProgram(parsed.fileNames, parsed.options)
+const edges = new Map()
+const violations = new Set()
+const inPackage = (path, name) => relative(root, path).startsWith(`packages${sep}${name}${sep}`)
+for (const file of program.getSourceFiles().filter(file => !file.isDeclarationFile)) {
+  const from = resolve(file.fileName)
+  const targets = []
+  const add = node => {
+    if (!node || !ts.isStringLiteralLike(node)) {
+      violations.add('dynamic')
+      return
+    }
+    const specifier = node.text
+    const target = ts.resolveModuleName(specifier, from, parsed.options, ts.sys).resolvedModule
+    if (!target) throw new Error(`Unresolved import: ${specifier}`)
+    const to = resolve(target.resolvedFileName)
+    targets.push(to)
+    if (inPackage(from, 'web') && inPackage(to, 'core') &&
+        to !== resolve(root, 'packages/core/index.ts')) {
+      violations.add(specifier.startsWith('@storage/') ? 'alias' : 'private')
+    }
+  }
+  const visit = node => {
+    if (ts.isImportDeclaration(node) || ts.isExportDeclaration(node)) {
+      if (node.moduleSpecifier) add(node.moduleSpecifier)
+    } else if (ts.isImportEqualsDeclaration(node) && ts.isExternalModuleReference(node.moduleReference)) {
+      add(node.moduleReference.expression)
+    } else if (ts.isImportTypeNode(node)) {
+      add(ts.isLiteralTypeNode(node.argument) ? node.argument.literal : node.argument)
+    } else if (ts.isCallExpression(node) && node.expression.kind === ts.SyntaxKind.ImportKeyword) {
+      add(node.arguments[0])
+    } else if (ts.isCallExpression(node) && ts.isIdentifier(node.expression) && node.expression.text === 'require') {
+      violations.add('dynamic')
+    }
+    ts.forEachChild(node, visit)
+  }
+  visit(file)
+  edges.set(from, targets)
+}
+const visiting = new Set()
+const visited = new Set()
+function cycle(file) {
+  if (visiting.has(file)) return true
+  if (visited.has(file)) return false
+  visiting.add(file)
+  const found = (edges.get(file) ?? []).some(cycle)
+  visiting.delete(file)
+  visited.add(file)
+  return found
+}
+if ([...edges.keys()].some(cycle)) violations.add('cycle')
+console.log(JSON.stringify([...violations].sort()))
+process.exitCode = violations.size ? 1 : 0
