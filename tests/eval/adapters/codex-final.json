{
  "schemaVersion": 1,
  "executable": "codex",
  "args": ["--no-daemon", "exec", "--json", "--ignore-user-config", "--ignore-rules", "--skip-git-repo-check", "--model", "gpt-6.1-sol", "--sandbox", "danger-full-access", "-c", "model_reasoning_effort=\"medium\"", "{message}"],
  "cwd": ".",
  "versionArgs": ["--version"],
  "timeoutMs": 1800000,
  "outputLimitBytes": 16777216,
  "invocation": {
    "agent": "codex",
    "model": "gpt-6.1-sol",
    "explicit": "${skill}",
    "protocol": "codex-exec-jsonl",
    "resumeArgs": ["--no-daemon", "exec", "resume", "--json", "--ignore-user-config", "--ignore-rules", "--skip-git-repo-check", "--model", "gpt-6.1-sol", "-c", "model_reasoning_effort=\"medium\"", "-c", "sandbox_mode=\"danger-full-access\"", "{sessionId}", "{message}"]
  },
  "isolation": {
    "stateDirectory": ".codex",
    "discoveryPaths": [".agents/skills", ".codex/skills"],
    "systemDiscoveryPaths": ["/etc/codex/skills"],
    "skillsPath": ".agents/skills",
    "authentication": "throwaway-codex-login"
  }
}
