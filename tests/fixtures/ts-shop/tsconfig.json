{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@storage/*": [
        "packages/core/internal/*.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts"
  ]
}
